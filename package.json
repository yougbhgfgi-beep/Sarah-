{
  "name": "sara",
  "version": "8.3.3",
  "private": true,
  "description": "كلام من محمد لساره — موقع ثابت (HTML + React bundle + PWA)",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve . -l 5173",
    "version:bump": "node tools/bump-version.mjs patch",
    "version:bump:minor": "node tools/bump-version.mjs minor",
    "version:bump:major": "node tools/bump-version.mjs major",
    "check": "node --check assets/app.js && node --check config.js && node --check sw.js && node --check install.js && node --check letter-nav.js && node --check love-meter.js && node --check game-overlay.js",
    "test:negation": "node tools/negation.test.mjs",
    "icons": "node tools/make-icons.mjs",
    "patch": "node tools/patch-strings.mjs",
    "patch:structure": "node tools/patch-structure.mjs",
    "sync:bundle": "node tools/sync-bundle-defaults.mjs",
    "audit": "node tools/audit-content.mjs",
    "strings": "node tools/list-strings.mjs",
    "probe:audio": "node tools/probe-audio.mjs",
    "deploy:url": "node tools/set-deploy-url.mjs",
    "pages:on": "node tools/enable-pages.mjs",
    "verify": "node tools/verify-config.mjs",
    "test": "npm run check && npm run test:negation && npm run audit && npm run verify && npm run check:game && npm run test:boot",
    "check:game": "node tools/check-game.mjs",
    "test:boot": "node tools/boot-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5"
  }
}
